{
  "title": "LearnTree tree",
  "description": "A learning tree: nested nodes with categorized atomic modules (trees/<tree-id>.yaml).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "learntree": {
      "type": "number",
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/__schema0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "order": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema1"
      }
    }
  },
  "required": [
    "learntree",
    "id",
    "title",
    "nodes"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "__schema1": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/__schema0"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "display": {
          "type": "string",
          "enum": [
            "group",
            "card"
          ]
        },
        "dependsOn": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema0"
          }
        },
        "categories": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "modules": {
                "type": "array",
                "items": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "ref": {
                          "$ref": "#/$defs/__schema0"
                        }
                      },
                      "required": [
                        "ref"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "id": {
                          "$ref": "#/$defs/__schema0"
                        },
                        "title": {
                          "type": "string",
                          "minLength": 1
                        },
                        "url": {
                          "type": "string",
                          "format": "uri"
                        },
                        "tag": {
                          "type": "string",
                          "enum": [
                            "book",
                            "video",
                            "website",
                            "course",
                            "paper",
                            "exercise",
                            "other"
                          ]
                        },
                        "section": {
                          "type": "string",
                          "minLength": 1
                        },
                        "difficulty": {
                          "type": "string",
                          "enum": [
                            "easy",
                            "medium",
                            "hard"
                          ]
                        },
                        "weight": {
                          "type": "number",
                          "exclusiveMinimum": 0
                        },
                        "aliases": {
                          "type": "array",
                          "items": {
                            "$ref": "#/$defs/__schema0"
                          }
                        }
                      },
                      "required": [
                        "id",
                        "title"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              }
            },
            "required": [
              "name",
              "modules"
            ],
            "additionalProperties": false
          }
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/__schema1"
          }
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    }
  }
}
