{
  "title": "LearnTree forest",
  "description": "Forest metadata, settings, and cross-tree equivalences (forest.yaml).",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "learntree": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "countSatisfied": {
          "type": "string",
          "enum": [
            "complete",
            "fractional",
            "manual-only"
          ]
        }
      },
      "additionalProperties": false
    },
    "equivalences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/__schema0"
          },
          "sufficient": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "satisfies": {
            "minItems": 1,
            "type": "array",
            "items": {
              "$ref": "#/$defs/__schema0"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sufficient",
          "satisfies"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "learntree",
    "name"
  ],
  "additionalProperties": false,
  "$defs": {
    "__schema0": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    }
  }
}
